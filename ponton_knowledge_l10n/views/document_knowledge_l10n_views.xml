<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="document_knowledge.menu_document_root" model="ir.ui.menu">
        <field name="name">Conocimientos</field>
    </record>

    <record id="document_knowledge.menu_document" model="ir.ui.menu">
        <field name="name">Documentos</field>
    </record>

    <record id="document_knowledge.menu_document_section" model="ir.ui.menu">
        <field name="name">Documentos</field>
    </record>

    <record id="document_knowledge.menu_document_configuration" model="ir.ui.menu">
        <field name="name">Configuración</field>
    </record>

    <record id="document_knowledge.menu_knowledge_configuration" model="ir.ui.menu">
        <field name="name">Ajustes</field>
    </record>

    <record id="document_knowledge.knowledge_action_documents" model="ir.actions.act_window">
        <field name="name">Documentos</field>
    </record>

    <record id="document_knowledge.action_knowledge_configuration" model="ir.actions.act_window">
        <field name="name">Ajustes</field>
    </record>

    <record id="view_knowledge_configuration_l10n_ponton" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.knowledge.l10n.ponton</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="document_knowledge.view_knowledge_configuration" />
        <field name="arch" type="xml">
            <xpath expr="//app[@name='document_knowledge']" position="attributes">
                <attribute name="string">Conocimientos</attribute>
                <attribute name="data-string">Conocimientos</attribute>
            </xpath>
            <xpath expr="//block[@name='maintenance_mode_setting']" position="attributes">
                <attribute name="title">Gestión de documentos y conocimientos</attribute>
            </xpath>
            <xpath expr="//setting[@id='attachment_user']" position="attributes">
                <attribute name="help">Al activar esta opción, los usuarios podrán gestionar adjuntos de forma centralizada desde el menú Conocimientos/Documentos.</attribute>
            </xpath>
        </field>
    </record>
</odoo>
