<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="account_bank_statement_import_view_ponton_excel" model="ir.ui.view">
        <field name="name">account.bank.statement.import.form.ponton.excel</field>
        <field name="model">account.bank.statement.import</field>
        <field name="inherit_id" ref="account_bank_statement_import.account_bank_statement_import_view"/>
        <field name="arch" type="xml">
            <xpath expr="//ul[@id='statement_format']" position="inside">
                <li>Excel Banco Macro (.xls/.xlsx)</li>
                <li>Excel MercadoPago movimientos (.xlsx)</li>
            </xpath>
            <xpath expr="//footer/button[@name='import_file']" position="before">
                <button name="action_preview_macro_excel" string="Vista previa Macro" type="object" class="btn-secondary"/>
                <button name="action_preview_mercadopago_excel" string="Vista previa MP" type="object" class="btn-secondary"/>
            </xpath>
        </field>
    </record>
</odoo>
