<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_ponton_reconciliation_batch_list" model="ir.ui.view">
        <field name="name">ponton.reconciliation.batch.list</field>
        <field name="model">ponton.reconciliation.batch</field>
        <field name="arch" type="xml">
            <list string="Corridas de conciliación">
                <field name="started_at"/>
                <field name="name"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="mode"/>
                <field name="detected_count"/>
                <field name="created_count"/>
                <field name="existing_count"/>
                <field name="suggested_count"/>
                <field name="error_count"/>
            </list>
        </field>
    </record>

    <record id="view_ponton_reconciliation_batch_form" model="ir.ui.view">
        <field name="name">ponton.reconciliation.batch.form</field>
        <field name="model">ponton.reconciliation.batch</field>
        <field name="arch" type="xml">
            <form string="Corrida de conciliación">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="mode"/>
                        </group>
                        <group>
                            <field name="started_at"/>
                            <field name="finished_at"/>
                            <field name="detected_count"/>
                            <field name="created_count"/>
                            <field name="existing_count"/>
                            <field name="suggested_count"/>
                            <field name="applied_count"/>
                            <field name="error_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Pendientes">
                            <field name="issue_ids"/>
                        </page>
                        <page string="Notas">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_ponton_reconciliation_batch" model="ir.actions.act_window">
        <field name="name">Corridas de conciliación</field>
        <field name="res_model">ponton.reconciliation.batch</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>

