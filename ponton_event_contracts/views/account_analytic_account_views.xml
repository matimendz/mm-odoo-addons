<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_analytic_account_form_ponton_contracts" model="ir.ui.view">
        <field name="name">account.analytic.account.form.inherit.ponton.contracts</field>
        <field name="model">account.analytic.account</field>
        <field name="inherit_id" ref="analytic.view_account_analytic_account_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='plan_id']" position="after">
                <field name="ponton_contract_required_for_events"
                       invisible="plan_id.name != 'Tipo de Operación'"/>
            </xpath>
        </field>
    </record>

    <record id="view_account_analytic_account_list_ponton_contracts" model="ir.ui.view">
        <field name="name">account.analytic.account.list.inherit.ponton.contracts</field>
        <field name="model">account.analytic.account</field>
        <field name="inherit_id" ref="analytic.view_account_analytic_account_list"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='plan_id']" position="after">
                <field name="ponton_contract_required_for_events" optional="hide"/>
            </xpath>
        </field>
    </record>
</odoo>
