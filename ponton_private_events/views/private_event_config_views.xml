<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ponton_private_event_package_list" model="ir.ui.view">
        <field name="name">ponton.private.event.package.list</field>
        <field name="model">ponton.private.event.package</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="commercial_model"/>
                <field name="minimum_guests"/>
                <field name="price_per_person"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="view_ponton_private_event_package_form" model="ir.ui.view">
        <field name="name">ponton.private.event.package.form</field>
        <field name="model">ponton.private.event.package</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="sequence"/>
                            <field name="active"/>
                            <field name="commercial_model"/>
                        </group>
                        <group>
                            <field name="minimum_guests"/>
                            <field name="price_per_person"/>
                            <field name="product_id"/>
                        </group>
                    </group>
                    <group>
                        <field name="included_services"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_ponton_private_event_package" model="ir.actions.act_window">
        <field name="name">Paquetes privados</field>
        <field name="res_model">ponton.private.event.package</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_ponton_private_event_rate_list" model="ir.ui.view">
        <field name="name">ponton.private.event.rate.list</field>
        <field name="model">ponton.private.event.rate</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="season_band"/>
                <field name="day_type"/>
                <field name="space_fee"/>
                <field name="minimum_consumption"/>
                <field name="usd_reference"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="view_ponton_private_event_rate_form" model="ir.ui.view">
        <field name="name">ponton.private.event.rate.form</field>
        <field name="model">ponton.private.event.rate</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="active"/>
                            <field name="season_band"/>
                            <field name="day_type"/>
                        </group>
                        <group>
                            <field name="space_fee"/>
                            <field name="minimum_consumption"/>
                            <field name="usd_reference"/>
                            <field name="valid_from"/>
                            <field name="valid_to"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_ponton_private_event_rate" model="ir.actions.act_window">
        <field name="name">Tarifas privadas</field>
        <field name="res_model">ponton.private.event.rate</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_ponton_private_event_blackout_list" model="ir.ui.view">
        <field name="name">ponton.private.event.blackout.list</field>
        <field name="model">ponton.private.event.blackout</field>
        <field name="arch" type="xml">
            <list>
                <field name="date"/>
