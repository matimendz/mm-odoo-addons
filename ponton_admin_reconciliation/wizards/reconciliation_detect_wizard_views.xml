<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_ponton_reconciliation_detect_wizard_form" model="ir.ui.view">
        <field name="name">ponton.reconciliation.detect.wizard.form</field>
        <field name="model">ponton.reconciliation.detect.wizard</field>
        <field name="arch" type="xml">
            <form string="Detectar pendientes">
                <group>
                    <field name="company_id" groups="base.group_multi_company"/>
                    <field name="date_from"/>
                    <field name="date_to"/>
                    <field name="dry_run"/>
                    <field name="include_reconciled"/>
                </group>
                <footer>
                    <button name="action_detect" type="object" string="Detectar" class="btn-primary"/>
                    <button string="Cancelar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_ponton_reconciliation_detect_wizard" model="ir.actions.act_window">
        <field name="name">Detectar pendientes</field>
        <field name="res_model">ponton.reconciliation.detect.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>

