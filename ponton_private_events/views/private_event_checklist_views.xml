<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ponton_private_event_incident_list" model="ir.ui.view">
        <field name="name">ponton.private.event.incident.list</field>
        <field name="model">ponton.private.event.incident</field>
        <field name="arch" type="xml">
            <list>
                <field name="date"/>
                <field name="name"/>
                <field name="event_id"/>
                <field name="severity"/>
            </list>
        </field>
    </record>
    <record id="view_ponton_private_event_incident_form" model="ir.ui.view">
        <field name="name">ponton.private.event.incident.form</field>
        <field name="model">ponton.private.event.incident</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="event_id"/>
                        <field name="date"/>
                        <field name="severity"/>
                    </group>
                    <group>
                        <field name="description"/>
                        <field name="resolution"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_ponton_private_event_incident" model="ir.actions.act_window">
        <field name="name">Incidentes privados</field>
        <field name="res_model">ponton.private.event.incident</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
