<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_journal_form_ponton_macro_import" model="ir.ui.view">
        <field name="name">account.journal.form.ponton.macro.import</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='bank_statements_source']" position="after">
                <group string="Banco Macro" invisible="type != 'bank'">
                    <field name="ponton_macro_import_from_date"/>
                    <field name="ponton_macro_use_opening_balance"/>
                    <field name="ponton_macro_opening_balance_date"
                           invisible="not ponton_macro_use_opening_balance"/>
                    <field name="ponton_macro_opening_balance"
                           invisible="not ponton_macro_use_opening_balance"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
