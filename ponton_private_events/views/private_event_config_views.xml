        </field>
    </record>
    <record id="action_ponton_private_event_blackout" model="ir.actions.act_window">
        <field name="name">Blackouts privados</field>
        <field name="res_model">ponton.private.event.blackout</field>
        <field name="view_mode">list,form</field>
    </record>

