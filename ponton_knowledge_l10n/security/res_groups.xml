        <field name="implied_ids" eval="[(4, ref('document_knowledge.group_document_user'))]" />
    </record>

    <record id="document_page.group_document_manager" model="res.groups">
        <field
            name="implied_ids"
            eval="[
                (4, ref('group_ponton_admin')),
                (4, ref('group_ponton_operations_manager')),
                (4, ref('group_ponton_cashier')),
                (4, ref('group_ponton_bar')),
                (4, ref('group_ponton_salon')),
                (4, ref('group_ponton_kitchen')),
                (4, ref('group_ponton_maintenance')),
                (4, ref('group_ponton_marketing')),
                (4, ref('group_ponton_security'))
